# ─────────────────────────────────────────────────────────────────────────────
# Prompt0r runs from index.html + src/ alone. Everything ignored below is
# either machine-generated, personal to one developer, or an OS artifact.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies (nothing here is needed at runtime) ────────────────────────
node_modules/
jspm_packages/
.pnp
.pnp.js
bower_components/

# ── Package manager noise ───────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.yarn/
.pnpm-store/

# ── Editor and IDE settings (personal, not project config) ──────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.\#*
\#*\#

# ── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Build, deploy, and host caches ──────────────────────────────────────────
dist/
build/
out/
.cache/
.parcel-cache/
.temp/
tmp/
.vercel/
.netlify/
.firebase/
.wrangler/

# ── Local environment and secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Test, coverage, and scratch output ──────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
*.log
scratch/
screenshots/
*.local.*
